# Last.fm supplies the track. Server-only, never sent to the browser.
# API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=

# Optional. With these the now-playing link resolves to the exact Spotify track
# page; without them it falls back to a Spotify search link. Client credentials
# only, so no Spotify account is connected and no user login is involved.
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
